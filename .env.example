# Server-only AI/ML API configuration. Never prefix these with VITE_.
AIML_API_KEY=replace_with_your_aiml_api_key
AIML_MODEL=replace_with_your_model_id
AIML_API_URL=https://api.aimlapi.com/v1/chat/completions

# Local/production server port.
PORT=8787

# CMS database: use an absolute path on a persistent disk when deploying.
# CMS_DB_PATH=/path/to/persistent/portfolio.sqlite
# Production requires both of these (HTTPS enables secure admin cookies).
# NODE_ENV=production
# PUBLIC_ORIGIN=https://kyawhmuesan.dev

# Static public site: set this in Render's STATIC SITE build environment.
# VITE_CHAT_API_URL=https://your-rim-api.onrender.com
# Do not put an API key in any VITE_ variable.

# Local dashboard enabled by default outside production.
# The Render chat entry point always disables it.
# CMS_ENABLED=true
